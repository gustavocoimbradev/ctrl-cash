{
	admin off
}

# The one public address (SITE_ADDRESS is PUBLIC_URL, or just :80 behind a Cloudflare Tunnel, which already brings https).
{$SITE_ADDRESS} {
	root * /srv
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Built assets have a content hash in the name: cache them for good. The page itself is always revalidated.
	@assets path /_expo/static/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	@page path / /index.html
	header @page Cache-Control "no-cache"
	@api path /api/*
	header @api Cache-Control "no-store"

	# The API (same origin as the app, so no CORS)
	handle /api/* {
		reverse_proxy api:3000
	}

	# Single-page app: any path that is not a file gets the page.
	handle {
		try_files {path} /index.html
		file_server
	}
}

# Only for the container's own health check: it is not published.
http://:8081 {
	respond /up "ok" 200
}

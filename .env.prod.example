# Production settings. `make up:prod` creates .env.prod from this file the first time (it stays on the server, never in git).

# The address people will use. `make up:prod` asks for it the first time and writes it here. A domain
# (https://ctrlcash.gustavocoimbra.com) must point at this server with ports 80 and 443 open: the HTTPS certificate is
# asked for and renewed by itself. An IP address or localhost works over plain http (http://203.0.113.5).
PUBLIC_URL=https://ctrlcash.gustavocoimbra.com

# Optional. For a server at home (or any machine without a fixed IP or open ports): a Cloudflare Tunnel token.
# With it, make up:prod starts the tunnel and keeps the ports on this machine only (moved away from 80/443, so it never
# clashes with another project on the same server). USE A TUNNEL OF ITS OWN for this project (not the one of another
# project): in the tunnel's public hostname, the service is  http://web:80  and PUBLIC_URL is the https hostname.
# Leave empty for the normal setup (a domain pointing at this server, ports 80 and 443 open).
TUNNEL_TOKEN=

# The Firebase project used ONLY to sign in (email/password and Google). The default is this project's public web config.
FIREBASE_PROJECT_ID=moneey-bb0d8

# Generated for you by `make up:prod`. Keep it: it is the database password (a new one would not open the existing database).
POSTGRES_PASSWORD=

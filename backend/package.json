    "export-db": "node dist/tools/import-export.js export",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "fastify": "^5.12.8",
    "jose": "^6.2.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
